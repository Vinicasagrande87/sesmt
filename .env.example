# Copie para .env e preencha. O .env NAO vai para o git.

# Servidor
PORT=3000

# Banco PostgreSQL (connection string do provedor: Neon, Supabase, Render, Railway...)
# Use um banco separado para desenvolvimento e outro para producao.
DATABASE_URL=postgres://usuario:senha@host:5432/sesmt
# DB_SSL=false                      # so para Postgres local sem SSL
# DB_SSL_REJECT_UNAUTHORIZED=false  # so se o provedor usar certificado nao verificavel

# Autenticacao (JWT)
# Gere um segredo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Endereco publico do sistema (usado nos links dos e-mails). Obrigatorio em producao.
APP_URL=https://sesmt.exemplo.com.br

# Outros sites que podem chamar a API pelo navegador (separados por virgula). Vazio = so o proprio sistema.
CORS_ORIGINS=

# E-mail (SMTP) para avisos de vencimento e redefinicao de senha. Sem SMTP_HOST o envio fica desligado.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                   # true para a porta 465
SMTP_USER=
SMTP_PASS=
EMAIL_REMETENTE="SESMT <nao-responda@exemplo.com.br>"

# Avisos de vencimento: 1 mes de antecedencia, para os admins + destinatarios cadastrados no sistema
# AVISOS_AUTOMATICOS=false          # desliga o envio semanal
AVISOS_DIA_SEMANA=1                 # 0 = domingo, 1 = segunda...
AVISOS_HORA=7                       # a partir desta hora (Brasilia)
