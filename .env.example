# Copie para .env e preencha. O .env NAO vai para o git.

# Servidor
PORT=3000

# Banco de desenvolvimento (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sesmt

# Producao (Postgres) - usado so com NODE_ENV=production
# DATABASE_URL=postgres://usuario:senha@host:5432/sesmt

# Autenticacao (JWT)
# Gere um segredo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
